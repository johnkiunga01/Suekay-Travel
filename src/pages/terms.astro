---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Terms & Conditions' },
];
---

<BaseLayout
  title="Terms & Conditions"
  description="Review the terms and conditions for using SueKay Tours & Travel services."
>
  <!-- Breadcrumbs -->
  <Breadcrumbs items={breadcrumbs} />

  <!-- Hero Section -->
  <section class="relative w-full py-12 sm:py-16 lg:py-24 overflow-hidden bg-gradient-to-br from-primary/10 to-secondary/10">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="font-heading font-bold text-primary text-4xl sm:text-5xl lg:text-6xl mb-6">
          Terms & Conditions
        </h1>
        <p class="font-body text-muted-foreground text-lg sm:text-xl">
          Effective Date: June 16, 2024 | Last Updated: June 16, 2024
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="w-full py-12 sm:py-16 lg:py-20 bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto space-y-10 sm:space-y-12">
        <div>
          <p class="font-body text-muted-foreground text-lg leading-relaxed">
            Welcome to SueKay Tours & Travel. These Terms and Conditions ("Agreement") govern your use of our website, services, and all related offerings. By accessing or using our services, you acknowledge that you have read, understood, and agree to be bound by these terms. If you do not agree with any part of these terms, you must not use our services.
          </p>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            1. Booking Terms
          </h2>
          <div class="space-y-4">
            <div>
              <h3 class="font-heading font-semibold text-secondary text-lg mb-2">
                1.1 Age and Capacity
              </h3>
              <p class="font-body text-muted-foreground leading-relaxed">
                By making a booking, you confirm that you are at least 18 years of age and have the legal capacity to enter into this Agreement. If you are booking on behalf of minors or other individuals, you accept full responsibility for those individuals and agree that all terms apply to them.
              </p>
            </div>

            <div>
              <h3 class="font-heading font-semibold text-secondary text-lg mb-2">
                1.2 Accurate Information
              </h3>
              <p class="font-body text-muted-foreground leading-relaxed">
                You agree to provide accurate, current, and complete information during the booking process. This includes your full name (as it appears on your passport), contact details, passport information, and any special requirements or medical conditions that may affect your tour. You are responsible for notifying us of any changes to this information immediately.
              </p>
            </div>

            <div>
              <h3 class="font-heading font-semibold text-secondary text-lg mb-2">
                1.3 Booking Confirmation
              </h3>
              <p class="font-body text-muted-foreground leading-relaxed">
                A booking is not confirmed until we send you a written confirmation with full details and a booking reference. We reserve the right to decline any booking at our sole discretion.
              </p>
            </div>
          </div>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            2. Payment Terms
          </h2>
          <div class="space-y-4">
            <p class="font-body text-muted-foreground leading-relaxed">
              Payment terms and deposit requirements are specified at the time of booking. Typical payment schedule:
            </p>
            <ul class="font-body text-muted-foreground space-y-2 ml-4">
              <li class="flex gap-3">
                <span class="text-primary font-bold">•</span>
                <span><strong>Deposit:</strong> 30% of tour price due within 7 days of booking</span>
              </li>
              <li class="flex gap-3">
                <span class="text-primary font-bold">•</span>
                <span><strong>Final Payment:</strong> 70% due 60 days before departure</span>
              </li>
            </ul>
            <p class="font-body text-muted-foreground mt-4 leading-relaxed">
              We accept payment via bank transfer, credit card, and other methods specified on our website. All prices are in USD unless otherwise stated. You are responsible for any currency conversion fees.
            </p>
            <p class="font-body text-muted-foreground mt-4 leading-relaxed">
              Late payment may result in booking cancellation without liability to us. Invoice payments must be settled within the stated payment terms.
            </p>
          </div>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            3. Cancellation and Refund Policy
          </h2>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">
            Cancellations must be made in writing to our customer service team. Refund policies are as follows:
          </p>
          <div class="overflow-x-auto mb-4">
            <table class="w-full border border-border text-sm">
              <thead class="bg-primary text-white">
                <tr>
                  <th class="p-3 text-left">Days Before Departure</th>
                  <th class="p-3 text-left">Refund Amount</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-border">
                  <td class="p-3">More than 60 days</td>
                  <td class="p-3">100% refund (minus 5% administration fee)</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="p-3">30-60 days</td>
                  <td class="p-3">50% refund</td>
                </tr>
                <tr class="border-b border-border">
                  <td class="p-3">15-30 days</td>
                  <td class="p-3">25% refund</td>
                </tr>
                <tr>
                  <td class="p-3">Less than 15 days</td>
                  <td class="p-3">No refund</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="font-body text-muted-foreground leading-relaxed">
            Cancellations due to force majeure or events beyond our control may be handled on a case-by-case basis.
          </p>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            4. Limitation of Liability
          </h2>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">
            SueKay Tours & Travel acts as an agent for hotels, airlines, and other service providers. We are not responsible for:
          </p>
          <ul class="font-body text-muted-foreground space-y-2 ml-4">
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Acts of God, natural disasters, or force majeure events</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Flight cancellations or delays by airlines</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Hotel or accommodation issues beyond our control</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Personal injuries, accidents, or losses unless directly caused by our negligence</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Missed flights, trains, or connections due to passenger tardiness</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Loss or damage to personal belongings or baggage</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Wildlife sightings not occurring (safaris are wildlife viewing, not guaranteed encounters)</span>
            </li>
          </ul>
          <p class="font-body text-muted-foreground mt-4 leading-relaxed">
            Our maximum liability is limited to the total amount paid by you for the tour services.
          </p>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            5. Travel Insurance and Safety
          </h2>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">
            We strongly recommend that you purchase comprehensive travel insurance that covers medical expenses, trip cancellation, evacuation, and baggage loss. While we provide assistance and safety briefings, travel insurance is your personal responsibility.
          </p>
          <p class="font-body text-muted-foreground leading-relaxed">
            You are responsible for obtaining any required health precautions, vaccinations, and medical certifications for your destination. We provide health recommendations, but you must consult with your healthcare provider before traveling.
          </p>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            6. Passport, Visas, and Travel Documents
          </h2>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">
            You are responsible for:
          </p>
          <ul class="font-body text-muted-foreground space-y-2 ml-4">
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Ensuring your passport is valid for at least 6 months beyond your travel dates</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Obtaining appropriate visas and entry requirements for all destinations</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Obtaining travel permits and necessary documentation</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Ensuring you meet all health and vaccination requirements</span>
            </li>
          </ul>
          <p class="font-body text-muted-foreground mt-4 leading-relaxed">
            We can provide guidance on visa requirements, but we are not responsible for visa rejections or delays in obtaining necessary documents. Entry denial due to missing documentation is non-refundable.
          </p>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            7. Conduct and Behavior
          </h2>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">
            Guests agree to:
          </p>
          <ul class="font-body text-muted-foreground space-y-2 ml-4">
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Follow all rules and safety instructions provided by guides and staff</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Respect local cultures, customs, and environments</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Not engage in illegal activities or substance abuse</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Treat staff, guides, and other guests with respect</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">•</span>
              <span>Follow wildlife viewing ethics and protection guidelines</span>
            </li>
          </ul>
          <p class="font-body text-muted-foreground mt-4 leading-relaxed">
            Violation of this code of conduct may result in immediate removal from the tour without refund.
          </p>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            8. Complaints and Dispute Resolution
          </h2>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">
            If you have a complaint regarding our services:
          </p>
          <ol class="font-body text-muted-foreground space-y-2 ml-4">
            <li class="flex gap-3">
              <span class="text-primary font-bold">1.</span>
              <span>Notify our guide or staff member immediately during the tour</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">2.</span>
              <span>Submit a written complaint to our customer service team within 14 days of tour completion</span>
            </li>
            <li class="flex gap-3">
              <span class="text-primary font-bold">3.</span>
              <span>We will investigate and respond within 30 days</span>
            </li>
          </ol>
          <p class="font-body text-muted-foreground mt-4 leading-relaxed">
            If disputes cannot be resolved amicably, they may be subject to mediation or arbitration according to Kenyan law.
          </p>
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            9. Modification of Tours and Terms
          </h2>
          <p class="font-body text-muted-foreground leading-relaxed">
            SueKay Tours & Travel reserves the right to modify itineraries due to weather, wildlife patterns, road conditions, or circumstances beyond our control. We will make reasonable efforts to minimize changes while maintaining safety and quality. Significant changes will be communicated to you as soon as possible. If essential itinerary elements are removed, appropriate refunds may be offered.
          </p>
        </div>

        <div class="bg-primary/10 rounded-lg p-6 sm:p-8 border border-primary/20">
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-4">
            10. Governing Law and Contact Information
          </h2>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">
            These Terms and Conditions are governed by the laws of Kenya and subject to the jurisdiction of Kenyan courts.
          </p>
          <p class="font-body text-muted-foreground mb-4 leading-relaxed">
            For questions or concerns regarding these Terms and Conditions:
          </p>
          <div class="space-y-2 font-body text-muted-foreground">
            <p><strong>Email:</strong> support@suekaytours.com</p>
            <p><strong>Phone:</strong> +254 (0) 711 111 111</p>
            <p><strong>Address:</strong> Nairobi, Kenya</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
</style>
