---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/hero/HeroSection.astro';
import CTASection from '@/components/content/CTASection.astro';
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';
import RatingStars from '@/components/content/RatingStars.astro';
import { getCollection } from 'astro:content';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Testimonials' },
];

// Fetch testimonials from collection
const testimonials = await getCollection('testimonials');

// Calculate average rating
const avgRating = testimonials.length > 0
  ? (testimonials.reduce((sum, t) => sum + t.data.rating, 0) / testimonials.length).toFixed(1)
  : 4.8;

const totalReviews = testimonials.length;

// Get featured testimonial (highest rated or first featured)
const featuredTestimonial = testimonials.find(t => t.data.featured) || testimonials[0];

// Get remaining testimonials
const otherTestimonials = testimonials.filter(t => t !== featuredTestimonial);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'SueKay Tours & Travel',
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: parseFloat(avgRating.toString()),
      ratingCount: totalReviews,
    },
  },
];
---

<BaseLayout
  title="Testimonials"
  description="Read what our travelers say about their experiences with SueKay Tours & Travel. See real reviews and ratings from satisfied customers."
  schema={schema}
>
  <!-- Breadcrumbs -->
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero Section -->
  <HeroSection
    title="What Our Travelers Say"
    subtitle="Discover why thousands of travelers trust SueKay Tours & Travel for their East African adventures"
    image="https://images.pexels.com/photos/1323550/pexels-photo-1323550.jpeg?auto=compress&cs=tinysrgb&w=1920"
    minHeight="min-h-[50vh]"
  />

  <!-- Stats Section -->
  <section class="py-8 sm:py-12 lg:py-16 bg-background border-b border-border">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 text-center">
        <div>
          <div class="text-4xl sm:text-5xl font-bold text-primary mb-2">
            {avgRating}
          </div>
          <div class="mb-2">
            <RatingStars rating={parseFloat(avgRating.toString())} />
          </div>
          <p class="text-muted-foreground font-body">
            Average Rating
          </p>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-bold text-secondary mb-2">
            {totalReviews}
          </div>
          <p class="text-muted-foreground font-body">
            Customer Reviews
          </p>
        </div>
        <div>
          <div class="text-4xl sm:text-5xl font-bold text-primary mb-2">
            10k+
          </div>
          <p class="text-muted-foreground font-body">
            Happy Travelers
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Testimonial -->
  {featuredTestimonial && (
    <section class="py-12 sm:py-16 lg:py-20 bg-muted">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
          <div class="bg-card rounded-lg shadow-lg p-8 sm:p-10">
            <div class="text-primary mb-6 opacity-30">
              <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                <path d="M3 21c3 0 7-1 7-8V5c0-1.25-4.716-4.688-7-4-3 0-6.688 2.844-6 7 0 2.5.75 5 1.972 6C1.08 18.494 0 20.25 0 21c0 1.6 1.2 2 2.5 2h4c2.1 0 4-1 4-3 0-3-2.668-4.688-6.5-4-1.813.359-3 .75-3 2.5 0 .375.125 1.047 2 2.047 1.5 1 3 2 5 2 1.25 0 3-1 3-4"/>
              </svg>
            </div>

            <div class="mb-6">
              <RatingStars rating={featuredTestimonial.data.rating} />
            </div>

            <p class="font-body text-foreground/70 text-lg leading-relaxed mb-8">
              {featuredTestimonial.data.content}
            </p>

            <div class="flex items-start gap-4">
              {featuredTestimonial.data.avatar && (
                <img
                  src={featuredTestimonial.data.avatar}
                  alt={featuredTestimonial.data.author}
                  class="w-16 h-16 rounded-full object-cover"
                />
              )}
              <div>
                <h3 class="font-heading font-bold text-primary text-lg">
                  {featuredTestimonial.data.author}
                </h3>
                {featuredTestimonial.data.company && (
                  <p class="text-muted-foreground">
                    {featuredTestimonial.data.company}
                    {featuredTestimonial.data.role && ` - ${featuredTestimonial.data.role}`}
                  </p>
                )}
                {featuredTestimonial.data.tourName && (
                  <p class="text-secondary text-sm font-heading">
                    {featuredTestimonial.data.tourName}
                  </p>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- All Testimonials Grid -->
  {otherTestimonials.length > 0 && (
    <section class="py-12 sm:py-16 lg:py-20 bg-background">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10 sm:mb-16">
          <h2 class="font-heading font-bold text-primary text-3xl sm:text-4xl mb-4">
            More Reviews
          </h2>
          <p class="font-body text-muted-foreground text-lg">
            Read what other travelers experienced
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {otherTestimonials.map((testimonial) => (
            <div class="bg-card rounded-lg border border-border p-6 hover:shadow-lg transition-shadow duration-300 flex flex-col">
              <div class="mb-4">
                <RatingStars rating={testimonial.data.rating} />
              </div>

              <div class="text-primary mb-3 opacity-20">
                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M3 21c3 0 7-1 7-8V5c0-1.25-4.716-4.688-7-4-3 0-6.688 2.844-6 7 0 2.5.75 5 1.972 6C1.08 18.494 0 20.25 0 21c0 1.6 1.2 2 2.5 2h4c2.1 0 4-1 4-3 0-3-2.668-4.688-6.5-4-1.813.359-3 .75-3 2.5 0 .375.125 1.047 2 2.047 1.5 1 3 2 5 2 1.25 0 3-1 3-4"/>
                </svg>
              </div>

              <p class="font-body text-foreground/70 text-sm leading-relaxed mb-4 flex-grow line-clamp-4">
                {testimonial.data.content}
              </p>

              <div class="border-t border-border pt-4 mt-4">
                <div class="flex items-center gap-3">
                  {testimonial.data.avatar && (
                    <img
                      src={testimonial.data.avatar}
                      alt={testimonial.data.author}
                      class="w-10 h-10 rounded-full object-cover"
                    />
                  )}
                  <div>
                    <h4 class="font-heading font-bold text-primary text-sm">
                      {testimonial.data.author}
                    </h4>
                    {testimonial.data.tourName && (
                      <p class="text-secondary text-xs font-heading">
                        {testimonial.data.tourName}
                      </p>
                    )}
                    {testimonial.data.company && !testimonial.data.tourName && (
                      <p class="text-muted-foreground text-xs">
                        {testimonial.data.company}
                      </p>
                    )}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {testimonials.length === 0 && (
    <section class="py-12 sm:py-16 lg:py-20 bg-background">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center py-12">
          <p class="text-muted-foreground text-lg mb-6">
            Testimonials coming soon! Join our growing community of satisfied travelers.
          </p>
          <a
            href="/contact"
            class="inline-block px-8 py-3 sm:px-10 sm:py-4 bg-primary text-white font-heading font-semibold rounded-lg hover:opacity-90 transition-all duration-300"
          >
            Start Your Adventure
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <CTASection
    title="Join Our Community of Satisfied Travelers"
    description="Experience the magic of East Africa with SueKay Tours & Travel. Create your own unforgettable memories."
    ctaText="Book Your Tour"
    ctaUrl="/tours"
    secondaryCtaText="Get in Touch"
    secondaryCtaUrl="/contact"
    variant="primary"
  />
</BaseLayout>

