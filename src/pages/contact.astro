---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/hero/HeroSection.astro';
import { ContactForm } from '@/components/forms/ContactForm.tsx';
import Breadcrumbs from '@/components/content/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Contact' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPoint',
    contactType: 'Customer Service',
    telephone: '+254-XXX-XXX-XXX',
    email: 'info@suekaytours.com',
    areaServed: ['KE', 'TZ', 'UG', 'RW'],
  },
];
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with SueKay Tours & Travel. Reach out with questions, inquiries, or to start planning your East African adventure."
  schema={schema}
>
  <!-- Breadcrumbs -->
  <Breadcrumbs items={breadcrumbItems} />

  <!-- Hero Section -->
  <HeroSection
    title="Get in Touch"
    subtitle="Have questions? Our friendly team is here to help with any inquiries about our services and experiences."
    image="https://images.pexels.com/photos/1323550/pexels-photo-1323550.jpeg?auto=compress&cs=tinysrgb&w=1920"
    minHeight="min-h-[50vh]"
  />

  <!-- Contact Content Section -->
  <section class="py-12 sm:py-16 lg:py-20 bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-6">
            Send us a Message
          </h2>
          <p class="text-muted-foreground mb-8">
            Fill out the form below and we'll get back to you as soon as possible. Typically within 24 hours.
          </p>
          <ContactForm client:load />
        </div>

        <div>
          <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-8">
            Contact Information
          </h2>

          <div class="space-y-8">
            <div class="flex gap-4 sm:gap-6">
              <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary text-white">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
              </div>
              <div>
                <h3 class="font-heading font-bold text-primary text-lg mb-1">
                  Phone
                </h3>
                <p class="text-muted-foreground mb-1">
                  +254 XXX XXX XXX
                </p>
                <p class="text-sm text-muted-foreground">
                  Available: 8am - 6pm EAT (Mon-Fri)
                </p>
              </div>
            </div>

            <div class="flex gap-4 sm:gap-6">
              <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-secondary text-white">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
              </div>
              <div>
                <h3 class="font-heading font-bold text-secondary text-lg mb-1">
                  Email
                </h3>
                <p class="text-muted-foreground mb-1">
                  info@suekaytours.com
                </p>
                <p class="text-sm text-muted-foreground">
                  Response within 24 hours
                </p>
              </div>
            </div>

            <div class="flex gap-4 sm:gap-6">
              <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-primary text-white">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
              </div>
              <div>
                <h3 class="font-heading font-bold text-primary text-lg mb-1">
                  Office Location
                </h3>
                <p class="text-muted-foreground">
                  Nairobi, Kenya
                </p>
              </div>
            </div>

            <div class="flex gap-4 sm:gap-6">
              <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-md bg-secondary text-white">
                  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-4.938 1.374c-1.5.87-2.852 2.115-3.733 3.61C2.33 10.16 1.7 12.083 1.7 14.03c0 1.947.63 3.87 1.817 5.514L1.67 22.78l2.532-.816c1.572.854 3.362 1.305 5.148 1.305 6.137 0 11.133-4.996 11.133-11.133 0-2.97-1.152-5.76-3.248-7.865-2.096-2.105-4.88-3.263-7.857-3.263z"/>
                  </svg>
                </div>
              </div>
              <div>
                <h3 class="font-heading font-bold text-secondary text-lg mb-1">
                  WhatsApp
                </h3>
                <p class="text-muted-foreground">
                  +254 XXX XXX XXX
                </p>
                <p class="text-sm text-muted-foreground">
                  Quick responses available
                </p>
              </div>
            </div>

            <div class="pt-4 border-t border-border">
              <h3 class="font-heading font-bold text-primary text-lg mb-4">
                Follow Us
              </h3>
              <div class="flex gap-4">
                <a href="#" class="text-primary hover:text-secondary transition-colors" aria-label="Facebook">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                  </svg>
                </a>
                <a href="#" class="text-primary hover:text-secondary transition-colors" aria-label="Instagram">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm4.441 15.892c-1.094 1.727-2.993 2.874-5.135 2.874-3.33 0-6.02-2.69-6.02-6.02 0-2.142 1.147-4.041 2.874-5.135a6 6 0 11.59-1.49c-2.084.938-3.88 2.734-4.818 4.818-.654 1.526-.957 3.107-.957 4.727 0 5.509 4.48 9.987 9.987 9.987 5.509 0 9.987-4.48 9.987-9.987 0-1.62-.303-3.201-.957-4.727a9 9 0 00-.59-1.49z"/>
                  </svg>
                </a>
                <a href="#" class="text-primary hover:text-secondary transition-colors" aria-label="Twitter">
                  <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-12 sm:py-16 lg:py-20 bg-muted">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-8 text-center">
        Our Location
      </h2>

      <div class="w-full h-96 rounded-lg overflow-hidden shadow-lg">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3988.8046236461236!2d36.7705!3d-1.2762!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zM8AyNzAnMDMuNiJTIDM2wzQ2JzExLjQiRQ!5e0!3m2!1sen!2ske!4v1234567890"
          width="100%"
          height="100%"
          style="border:0;"
          allowFullScreen=""
          loading="lazy"
          referrerPolicy="no-referrer-when-downgrade"
          title="SueKay Tours & Travel Location - Nairobi, Kenya"
        />
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-12 sm:py-16 lg:py-20 bg-background">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-heading font-bold text-primary text-2xl sm:text-3xl mb-8 text-center">
          Frequently Asked Questions
        </h2>

        <div class="space-y-4">
          <details class="group bg-card rounded-lg border border-border overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
            <summary class="flex items-center justify-between cursor-pointer p-4 sm:p-6 font-heading font-semibold text-primary hover:bg-muted transition-colors">
              <span class="text-base sm:text-lg pr-4">What is your response time?</span>
              <svg
                class="w-5 h-5 text-secondary flex-shrink-0 transition-transform duration-300 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"
                />
              </svg>
            </summary>
            <div class="border-t border-border">
              <p class="font-body text-muted-foreground p-4 sm:p-6 text-base">
                We aim to respond to all inquiries within 24 hours during business days. For urgent matters, please call us directly or contact us via WhatsApp.
              </p>
            </div>
          </details>

          <details class="group bg-card rounded-lg border border-border overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
            <summary class="flex items-center justify-between cursor-pointer p-4 sm:p-6 font-heading font-semibold text-primary hover:bg-muted transition-colors">
              <span class="text-base sm:text-lg pr-4">Do you offer custom tour packages?</span>
              <svg
                class="w-5 h-5 text-secondary flex-shrink-0 transition-transform duration-300 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"
                />
              </svg>
            </summary>
            <div class="border-t border-border">
              <p class="font-body text-muted-foreground p-4 sm:p-6 text-base">
                Absolutely! We specialize in creating custom itineraries tailored to your interests, budget, and schedule. Contact us to discuss your vision.
              </p>
            </div>
          </details>

          <details class="group bg-card rounded-lg border border-border overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300">
            <summary class="flex items-center justify-between cursor-pointer p-4 sm:p-6 font-heading font-semibold text-primary hover:bg-muted transition-colors">
              <span class="text-base sm:text-lg pr-4">What payment methods do you accept?</span>
              <svg
                class="w-5 h-5 text-secondary flex-shrink-0 transition-transform duration-300 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"
                />
              </svg>
            </summary>
            <div class="border-t border-border">
              <p class="font-body text-muted-foreground p-4 sm:p-6 text-base">
                We accept bank transfers, credit/debit cards, mobile money, and other payment methods. Discuss your preferred payment option when you contact us.
              </p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  details {
    transition: box-shadow 0.3s ease;
  }

  details[open] {
    box-shadow: 0 4px 12px rgba(61, 63, 151, 0.1);
  }
</style>
