---
const currentYear = new Date().getFullYear();
const destinations = [
  { label: 'Maasai Mara', href: '/destinations/maasai-mara' },
  { label: 'Amboseli', href: '/destinations/amboseli' },
  { label: 'Samburu', href: '/destinations/samburu' },
  { label: 'Diani Beach', href: '/destinations/diani' },
  { label: 'Zanzibar', href: '/destinations/zanzibar' },
  { label: 'Gorilla Trekking', href: '/destinations/uganda-gorilla' },
];

const services = [
  { label: 'Safaris', href: '/services/safaris' },
  { label: 'Corporate Travel', href: '/services/corporate-travel' },
  { label: 'Team Building', href: '/services/team-building' },
  { label: 'Vehicle Hire', href: '/services/vehicle-hire' },
  { label: 'Airport Transfers', href: '/services/airport-transfers' },
  { label: 'Beach Holidays', href: '/services/beach-holidays' },
];

const company = [
  { label: 'About Us', href: '/about' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'Testimonials', href: '/testimonials' },
  { label: 'Blog', href: '/blog' },
  { label: 'FAQ', href: '/faq' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-primary-900 text-white dark:bg-primary-950">
  <!-- Main Footer -->
  <div class="container mx-auto px-4 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="inline-block mb-4">
          <span class="text-2xl font-heading font-bold">Sue<span class="text-secondary">Kay</span></span>
          <span class="ml-1 text-sm font-heading text-white/70">Tours & Travel</span>
        </a>
        <p class="text-white/70 text-sm leading-relaxed mb-6 max-w-xs">
          Your trusted partner for premium East African safaris, corporate travel, team building, and transport services across Kenya and beyond.
        </p>
        <div class="flex gap-4">
          <a href="https://facebook.com/suekaytours" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-white/60 hover:text-secondary transition-colors">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://instagram.com/suekaytours" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-white/60 hover:text-secondary transition-colors">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://twitter.com/suekaytours" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="text-white/60 hover:text-secondary transition-colors">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://youtube.com/suekaytours" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-white/60 hover:text-secondary transition-colors">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Destinations -->
      <div>
        <h3 class="text-sm font-heading font-semibold uppercase tracking-wider text-secondary mb-4">Destinations</h3>
        <ul class="space-y-2.5">
          {destinations.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-white/60 hover:text-secondary transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-sm font-heading font-semibold uppercase tracking-wider text-secondary mb-4">Services</h3>
        <ul class="space-y-2.5">
          {services.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-white/60 hover:text-secondary transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company + Contact -->
      <div>
        <h3 class="text-sm font-heading font-semibold uppercase tracking-wider text-secondary mb-4">Company</h3>
        <ul class="space-y-2.5 mb-6">
          {company.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-white/60 hover:text-secondary transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
        <h3 class="text-sm font-heading font-semibold uppercase tracking-wider text-secondary mb-3">Contact</h3>
        <ul class="space-y-2 text-sm text-white/60">
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-secondary flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:+254700000000" class="hover:text-secondary transition-colors">+254 700 000 000</a>
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-secondary flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href="mailto:info@suekaytours.com" class="hover:text-secondary transition-colors">info@suekaytours.com</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="h-4 w-4 text-secondary flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Nairobi, Kenya</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="container mx-auto px-4 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/50">&copy; {currentYear} SueKay Tours & Travel Ltd. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-xs text-white/50 hover:text-secondary transition-colors">Privacy Policy</a>
        <a href="/terms" class="text-xs text-white/50 hover:text-secondary transition-colors">Terms & Conditions</a>
      </div>
    </div>
  </div>
</footer>
