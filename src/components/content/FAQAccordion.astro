---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FAQ[];
  title?: string;
  description?: string;
}

const { faqs = [], title, description } = Astro.props;
---

{faqs.length > 0 && (
  <section class="w-full py-8 sm:py-12">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      {(title || description) && (
        <div class="text-center mb-10 sm:mb-14">
          {title && (
            <h2 class="font-heading font-bold text-foreground text-3xl sm:text-4xl mb-4">
              {title}
            </h2>
          )}
          {description && (
            <p class="text-muted-foreground text-lg max-w-2xl mx-auto">
              {description}
            </p>
          )}
        </div>
      )}

      <div class="max-w-3xl mx-auto space-y-4">
        {faqs.map((faq, index) => (
          <details
            key={index}
            class="group bg-card rounded-lg border border-border overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-300"
          >
            <summary class="flex items-center justify-between cursor-pointer p-4 sm:p-6 font-heading font-semibold text-foreground hover:bg-accent/50 transition-colors">
              <span class="text-base sm:text-lg pr-4">{faq.question}</span>
              <svg
                class="w-5 h-5 text-secondary flex-shrink-0 transition-transform duration-300 group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"
                />
              </svg>
            </summary>

            <div class="border-t border-border">
              <p class="text-muted-foreground p-4 sm:p-6 text-base leading-relaxed">
                {faq.answer}
              </p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  details {
    transition: box-shadow 0.3s ease;
  }

  details[open] {
    box-shadow: 0 4px 12px hsl(var(--primary) / 0.1);
  }

  summary::-webkit-details-marker {
    display: none;
  }
</style>
