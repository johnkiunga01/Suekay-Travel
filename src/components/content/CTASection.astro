---
interface Props {
  title: string;
  description: string;
  ctaText: string;
  ctaUrl: string;
  secondaryCtaText?: string;
  secondaryCtaUrl?: string;
  variant?: 'primary' | 'secondary';
}

const {
  title,
  description,
  ctaText,
  ctaUrl,
  secondaryCtaText,
  secondaryCtaUrl,
  variant = 'primary',
} = Astro.props;

const isPrimaryVariant = variant === 'primary';
---

<section
  class={`relative w-full py-12 sm:py-16 lg:py-20 overflow-hidden ${
    isPrimaryVariant ? 'bg-gradient-primary' : 'bg-gradient-secondary'
  }`}
>
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class={`absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 blur-3xl ${
      isPrimaryVariant ? 'bg-primary' : 'bg-secondary'
    }`} />
    <div class={`absolute bottom-0 left-0 w-96 h-96 rounded-full opacity-10 blur-3xl ${
      isPrimaryVariant ? 'bg-secondary' : 'bg-primary'
    }`} />
  </div>

  <div class="relative z-10 container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading font-bold text-white text-3xl sm:text-4xl lg:text-5xl mb-4 sm:mb-6">
        {title}
      </h2>

      <p class="font-body text-white text-lg sm:text-xl mb-8 sm:mb-10 opacity-95">
        {description}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={ctaUrl}
          class={`inline-block px-8 py-3 sm:px-10 sm:py-4 font-heading font-semibold rounded-lg transition-all duration-300 hover:scale-105 shadow-lg ${
            isPrimaryVariant
              ? 'bg-white text-primary hover:bg-white/90'
              : 'bg-primary text-white hover:bg-primary-600'
          }`}
        >
          {ctaText}
        </a>

        {secondaryCtaText && secondaryCtaUrl && (
          <a
            href={secondaryCtaUrl}
            class={`inline-block px-8 py-3 sm:px-10 sm:py-4 font-heading font-semibold rounded-lg transition-all duration-300 hover:scale-105 shadow-lg border-2 ${
              isPrimaryVariant
                ? 'bg-transparent border-white text-white hover:bg-white/10'
                : 'bg-transparent border-white text-white hover:bg-white/10'
            }`}
          >
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
