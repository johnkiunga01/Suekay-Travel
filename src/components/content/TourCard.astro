---
interface Props {
  title: string;
  slug: string;
  image: string;
  duration: string;
  price: number;
  priceUnit?: string;
  destination: string;
  difficulty: 'easy' | 'moderate' | 'challenging';
  category: string;
}

const { title, slug, image, duration, price, priceUnit = 'USD', destination, difficulty, category } = Astro.props;

const safeDifficulty = difficulty || 'easy';

const difficultyColors: Record<string, string> = {
  easy: 'bg-green-500/20 text-green-400 dark:text-green-300',
  moderate: 'bg-yellow-500/20 text-yellow-600 dark:text-yellow-300',
  challenging: 'bg-red-500/20 text-red-600 dark:text-red-300',
};
---

<a href={`/tours/${slug}`} class="group block h-full">
  <div class="bg-card rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:scale-105 h-full flex flex-col border border-border">
    <div class="relative overflow-hidden aspect-video">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
      />
      <div class={`absolute top-4 right-4 px-3 py-1 rounded-full text-sm font-semibold ${difficultyColors[safeDifficulty] || difficultyColors.easy}`}>
        {safeDifficulty.charAt(0).toUpperCase() + safeDifficulty.slice(1)}
      </div>
    </div>

    <div class="p-4 sm:p-6 flex flex-col flex-grow">
      <div class="mb-2">
        <span class="text-secondary text-xs font-semibold uppercase tracking-wide">{category}</span>
      </div>

      <h3 class="font-heading font-bold text-primary text-lg sm:text-xl mb-2 line-clamp-2">
        {title}
      </h3>

      <p class="text-muted-foreground text-sm mb-4">{destination}</p>

      <div class="flex flex-wrap gap-3 mt-auto pt-4 border-t border-border">
        <div class="flex items-center gap-2 text-sm">
          <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-foreground">{duration}</span>
        </div>

        <div class="flex items-center gap-2 text-sm font-semibold text-primary ml-auto">
          <span>${price}</span>
          <span class="text-muted-foreground font-normal text-xs">{priceUnit}</span>
        </div>
      </div>
    </div>
  </div>
</a>
